---
// The sources table + per-source detail dialog: the table on /sources, the
// dialog alone on the search page (`list={false}`), where source chips on
// result cards open it. We fetch /meta at BUILD time and
// render the table into static HTML, so the source list is in the page Google
// receives (indexable) and shows instantly. Only source *metadata* is exposed
// here — never the bulk terminology, which stays behind the search API. The
// client script opens each source's detail dialog, re-fetches at runtime if a
// build couldn't reach the API (graceful fallback, so the table is never
// empty), and background-revalidates so the list self-heals after a D1 data
// reload with no site rebuild.
interface Props {
	list?: boolean;
}
const { list = true } = Astro.props;

const apiBase = (
	import.meta.env.PUBLIC_WORDBOOK_API ||
	(import.meta.env.DEV ? 'http://127.0.0.1:8787' : '')
).replace(/\/$/, '');

let sources = [];
if (apiBase) {
	try {
		const res = await fetch(apiBase + '/meta');
		if (res.ok) {
			const data = await res.json();
			sources = data.sources || [];
		}
	} catch {
		// Leave sources empty — the client script will fetch and render.
	}
}

// The API returns sources by slug, but the table shows titles, which often
// start with a different word (bgl is "Dutch-English Online Dictionary"), so
// put them in title order. The client script sorts the same way.
const titleCollator = new Intl.Collator('en', { sensitivity: 'base', ignorePunctuation: true });
sources.sort((a, b) => titleCollator.compare(a.title || a.slug, b.title || b.slug));

const langsOf = (s) => {
	const codes = (s.languages && s.languages.length ? s.languages : [s.source_lang, s.target_lang])
		.filter(Boolean).map((x) => String(x).toUpperCase());
	return codes.length ? codes.join(' · ') : '—';
};
// A multilingual source is shown as concepts (one card per row, with all its
// languages), not as entries, so its size is a concept count.
const sizeOf = (s) => s.concept_count
	? `${s.concept_count.toLocaleString('en-GB')} concepts`
	: (s.entry_count || 0).toLocaleString('en-GB');
const badgeClassOf = (s) => {
	const lic = (s.licence || 'unknown').toLowerCase();
	return ['restricted', 'permissive', 'own-work'].includes(lic) ? lic : '';
};
---

<!-- The full source list. A #slug fragment (an old /sources#slug or /#slug
     link) opens that source's dialog. -->
{list && (
<section id="sources" class="wb-view">
	<div id="wb-sources-wrap">
		{sources.length ? (
			<table class="wb-sources-table">
				<thead>
					<tr>
						<th aria-sort="ascending"><button type="button" class="wb-sort" data-key="title">Source</button></th>
						<th><button type="button" class="wb-sort" data-key="author">Author</button></th>
						<th><button type="button" class="wb-sort" data-key="year">Year</button></th>
						<th>Languages</th>
						<th class="num"><button type="button" class="wb-sort" data-key="entries">Entries</button></th>
						<th><button type="button" class="wb-sort" data-key="licence">Licence</button></th>
					</tr>
				</thead>
				<tbody>
					{sources.map((s) => (
						<tr class="clickable" data-slug={s.slug}>
							<td>{s.title || s.slug}<span class="wb-src-chip" title="The name shown on search results">{s.slug}</span></td>
							<td class:list={{ empty: !s.author }}>{s.author || '—'}</td>
							<td class:list={['num', { empty: !s.year }]}>{s.year || '—'}</td>
							<td class="langs">{langsOf(s)}</td>
							<td class="num entries">{sizeOf(s)}</td>
							<td><span class:list={['wb-badge', badgeClassOf(s)]}>{s.licence || 'unknown'}</span></td>
						</tr>
					))}
				</tbody>
			</table>
		) : (
			<p class="wb-loading">Loading sources…</p>
		)}
	</div>
</section>
)}

<!-- The dialog sits outside #sources so it works on the search page, which
     has no list (inside a hidden parent showModal() makes the page inert but
     draws the dialog at 0×0, so the page looks frozen). It must also come
     BEFORE the script below, which runs as soon as it is parsed. -->
<dialog id="wb-detail" class="wb-detail">
	<form method="dialog">
		<button class="wb-close" aria-label="Close">×</button>
	</form>
	<div id="wb-detail-body"></div>
</dialog>

<script type="application/json" id="wb-sources-data" is:inline set:html={JSON.stringify(sources)}></script>

<script define:vars={{ apiBase }}>
	// The source list is server-rendered above. This script only adds the
	// interactive detail dialog (and a client fallback if the build shipped no
	// data). It reads the embedded JSON — no per-visit API call when the build
	// already has the data.
	//
	// Wrapped in an IIFE: define:vars scripts are classic (non-module), so on
	// the home page this would otherwise share global scope with the search
	// script and collide on names like `escapeHtml` and `sources`.
	(() => {

	const escapeHtml = (s) =>
		(s ?? '').replace(/[&<>"']/g, (c) => ({
			'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
		}[c]));

	let sources = [];
	try {
		sources = JSON.parse(document.getElementById('wb-sources-data').textContent || '[]');
	} catch { sources = []; }

	const langsOf = (s) => {
		const codes = (s.languages && s.languages.length ? s.languages : [s.source_lang, s.target_lang])
			.filter(Boolean).map((x) => String(x).toUpperCase());
		return codes.length ? codes.join(' · ') : '—';
	};
	// Same as the build-time sizeOf above.
	const sizeOf = (s) => s.concept_count
		? `${s.concept_count.toLocaleString('en-GB')} concepts`
		: (s.entry_count || 0).toLocaleString('en-GB');

	// Column sorting. Title order is what the page is built with; clicking a
	// heading re-sorts by that column, clicking it again reverses it. Numbers
	// start largest-first, text A–Z. Rows without a value always go last.
	const collator = new Intl.Collator('en', { sensitivity: 'base', ignorePunctuation: true });
	const SORTS = {
		title:   { get: (s) => s.title || s.slug, num: false },
		author:  { get: (s) => s.author || '', num: false },
		year:    { get: (s) => Number(s.year) || null, num: true },
		entries: { get: (s) => s.entry_count || s.concept_count || 0, num: true },
		licence: { get: (s) => s.licence || '', num: false },
	};
	let sortKey = 'title';
	let sortDir = 1;   // 1 = ascending, -1 = descending

	function sorted(list) {
		const { get, num } = SORTS[sortKey];
		const empty = (v) => v === null || v === '';
		return [...list].sort((a, b) => {
			const va = get(a), vb = get(b);
			if (empty(va) || empty(vb)) return empty(va) - empty(vb);
			const c = num ? va - vb : collator.compare(va, vb);
			// Ties fall back to title order, so equal years stay alphabetical.
			return (c * sortDir) || collator.compare(SORTS.title.get(a), SORTS.title.get(b));
		});
	}

	function headCell(label, key, cls) {
		const sortAttr = key === sortKey ? ` aria-sort="${sortDir === 1 ? 'ascending' : 'descending'}"` : '';
		const inner = key ? `<button type="button" class="wb-sort" data-key="${key}">${label}</button>` : label;
		return `<th${cls ? ` class="${cls}"` : ''}${sortAttr}>${inner}</th>`;
	}

	function renderTable(list) {
		const wrap = document.getElementById('wb-sources-wrap');
		if (!wrap) return;   // the search page has the dialog only
		if (!list.length) {
			wrap.innerHTML = '<p class="wb-loading">No sources yet.</p>';
			return;
		}
		const rows = sorted(list).map((s) => {
			const lic = (s.licence || 'unknown').toLowerCase();
			const badgeClass = ['restricted', 'permissive', 'own-work'].includes(lic) ? lic : '';
			return `<tr class="clickable" data-slug="${escapeHtml(s.slug)}">
				<td>${escapeHtml(s.title || s.slug)}<span class="wb-src-chip" title="The name shown on search results">${escapeHtml(s.slug)}</span></td>
				<td${s.author ? '' : ' class="empty"'}>${escapeHtml(s.author || '—')}</td>
				<td class="num${s.year ? '' : ' empty'}">${escapeHtml(String(s.year || '—'))}</td>
				<td class="langs">${langsOf(s)}</td>
				<td class="num entries">${sizeOf(s)}</td>
				<td><span class="wb-badge ${badgeClass}">${escapeHtml(s.licence || 'unknown')}</span></td>
			</tr>`;
		}).join('');
		wrap.innerHTML = `<table class="wb-sources-table">
			<thead><tr>
				${headCell('Source', 'title')}${headCell('Author', 'author')}${headCell('Year', 'year')}${headCell('Languages', null)}${headCell('Entries', 'entries', 'num')}${headCell('Licence', 'licence')}
			</tr></thead>
			<tbody>${rows}</tbody>
		</table>`;
	}

	let lastSlug = null;

	function openDetail(slug) {
		const s = sources.find((x) => x.slug === slug);
		if (!s) return;
		lastSlug = slug;
		const dlg = document.getElementById('wb-detail');
		const body = document.getElementById('wb-detail-body');
		const rows = [
			['Publisher',       s.publisher],
			['Year',            s.year],
			['Languages',       (s.languages && s.languages.length
				? s.languages.map((c) => String(c).toUpperCase()).join(' · ')
				: [s.source_lang, s.target_lang].filter(Boolean).map((c) => String(c).toUpperCase()).join(' · ') || null)],
			['Domain',          s.primary_domain],
			['Subject tags',    s.subject_tags],
			['Licence',         s.licence],
			s.concept_count
				? ['Concepts',      `${s.concept_count.toLocaleString('en-GB')} (${(s.term_count || 0).toLocaleString('en-GB')} terms), each shown as one card with all its languages`]
				: ['Entries',       (s.entry_count || 0).toLocaleString('en-GB')],
		].filter(([, v]) => v != null && v !== '');
		// Clickable source link (only http/https, opened in a new tab).
		const urlHtml = (s.url && /^https?:\/\//i.test(s.url))
			? `<div class="src-url">🔗 <a href="${escapeHtml(s.url)}" target="_blank" rel="noopener noreferrer">${
				escapeHtml(s.url.replace(/^https?:\/\//i, '').replace(/\/$/, ''))}</a></div>`
			: '';
		body.innerHTML =
			`<h3>${escapeHtml(s.title || s.slug)}</h3>` +
			`<span class="wb-src-chip" title="The name shown on search results">${escapeHtml(s.slug)}</span>` +
			(s.author ? `<div class="author">${escapeHtml(s.author)}</div>` : '') +
			'<dl>' +
			rows.map(([k, v]) => `<dt>${escapeHtml(k)}</dt><dd>${escapeHtml(String(v))}</dd>`).join('') +
			'</dl>' +
			urlHtml +
			(s.description ? `<div class="desc">${escapeHtml(s.description)}</div>` : '');
		dlg.showModal();
		// Move focus into the dialog body instead of letting showModal()
		// auto-focus the × button (which draws a focus ring around it). Focus
		// stays trapped in the modal, so this is still keyboard/SR-friendly.
		body.setAttribute('tabindex', '-1');
		body.focus();
	}

	// One listener on the wrapper, not one per row: the table is re-rendered on
	// every sort and on a data refresh, and this survives that untouched.
	function wireTable() {
		const wrap = document.getElementById('wb-sources-wrap');
		if (!wrap) return;
		wrap.addEventListener('click', (ev) => {
			const btn = ev.target.closest('button.wb-sort');
			if (btn) {
				const key = btn.dataset.key;
				if (key === sortKey) sortDir = -sortDir;
				else { sortKey = key; sortDir = SORTS[key].num ? -1 : 1; }
				renderTable(sources);
				// Re-rendering dropped the focused button; put focus back on it so
				// a keyboard user can keep toggling.
				const again = wrap.querySelector(`button.wb-sort[data-key="${key}"]`);
				if (again) again.focus();
				return;
			}
			const row = ev.target.closest('tr.clickable');
			if (row) openDetail(row.dataset.slug);
		});
	}

	// When the dialog closes (× / Esc), scroll its row into view and flash it,
	// so you can see which source you were just looking at. Also drop the
	// #slug from the URL: hashchange only fires when the hash CHANGES, so a
	// stale fragment would swallow the next click on the same source chip.
	function bindDialogClose() {
		const dlg = document.getElementById('wb-detail');
		dlg.addEventListener('close', () => {
			if (location.hash) {
				history.replaceState(null, '', location.pathname + location.search);
			}
			if (!lastSlug) return;
			const row = document.querySelector(
				'#wb-sources-wrap tr[data-slug="' + (window.CSS && CSS.escape ? CSS.escape(lastSlug) : lastSlug) + '"]'
			);
			if (!row) return;
			row.scrollIntoView({ behavior: 'smooth', block: 'center' });
			row.classList.remove('wb-flash');
			void row.offsetWidth; // reflow so the animation restarts each time
			row.classList.add('wb-flash');
		});
	}

	// Stable signature of the list, so we only re-render when something actually
	// changed (avoids a needless reflow on every visit). Order-independent: the
	// page embeds the list in title order, the API returns it in slug order.
	const sigList = (list) =>
		JSON.stringify((list || []).map((s) =>
			[s.slug, s.title, s.author, s.year, s.entry_count, s.concept_count, s.licence, langsOf(s)])
			.sort((a, b) => (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0)));

	// Background revalidate: refresh /meta after load so the source list and the
	// counts self-heal after a D1 data reload, with no site rebuild. The static
	// render still shows instantly; this only repaints if the data changed.
	async function revalidate() {
		if (!apiBase) return;
		try {
			const r = await fetch(apiBase + '/meta', { headers: { Accept: 'application/json' } });
			if (!r.ok) return;
			const d = await r.json();
			const fresh = d.sources || [];
			if (fresh.length && sigList(fresh) !== sigList(sources)) {
				sources = fresh;
				renderTable(sources);
				// Keep a deep-linked dialog correct if the build had missed it.
				const dlg = document.getElementById('wb-detail');
				const hash = decodeURIComponent((location.hash || '').replace(/^#/, ''));
				if (hash && dlg && !dlg.open) openDetail(hash);
			}
		} catch { /* offline / API down — keep the static render */ }
	}

	async function main() {
		// Fallback: a build that couldn't reach the API ships no rows — fetch now.
		let didFetch = false;
		if (!sources.length && apiBase) {
			didFetch = true;
			try {
				const r = await fetch(apiBase + '/meta', { headers: { Accept: 'application/json' } });
				if (r.ok) {
					const d = await r.json();
					sources = d.sources || [];
					renderTable(sources);
				}
			} catch {
				const wrap = document.getElementById('wb-sources-wrap');
				if (wrap) wrap.innerHTML = '<p class="wb-loading">Could not load sources right now.</p>';
			}
		}
		wireTable();
		bindDialogClose();

		// A source chip on a result card links to /#slug, and /sources#slug
		// links still work — open that source's dialog. On-load covers arrivals
		// from elsewhere; hashchange covers chip clicks on the search page, where
		// only the fragment changes. Links from when the list sat on the front
		// page (/#sources) go to the Sources tab.
		const openFromHash = () => {
			const hash = decodeURIComponent((location.hash || '').replace(/^#/, ''));
			if (hash === 'sources' && !document.getElementById('wb-sources-wrap')) {
				location.replace('/sources/');
				return;
			}
			if (hash) openDetail(hash);
		};
		openFromHash();
		window.addEventListener('hashchange', openFromHash);

		// If we rendered from the baked data, quietly check for newer data.
		if (!didFetch) revalidate();
	}

	main();

	})();
</script>

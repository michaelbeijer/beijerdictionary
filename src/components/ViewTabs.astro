---
// The Search | Articles bar. Each is a real link to its own page (/,
// /articles) so all are real, indexable URLs. `current` highlights the
// active one. There is no Sources tab or page: the source list sits on the
// front page under the search box (/sources 301s to /, and source chips on
// result cards open the on-page detail dialog via /#slug).
interface Props {
	current: 'search' | 'articles';
}
const { current } = Astro.props;
---

<nav class="wb-tabs" aria-label="Views">
	<a
		class:list={['wb-tab', { active: current === 'search' }]}
		href="/"
		aria-current={current === 'search' ? 'page' : undefined}>Search</a
	>
	<a
		class:list={['wb-tab', { active: current === 'articles' }]}
		href="/articles/"
		aria-current={current === 'articles' ? 'page' : undefined}>Articles</a
	>
</nav>

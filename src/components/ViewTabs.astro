---
// The Search | Articles | Sources bar. Each is a real link to its own page
// (/, /articles, /sources) so all are real, indexable URLs. `current`
// highlights the active one. Source chips on result cards still open the
// source's detail dialog in place on the search page (via /#slug).
interface Props {
	current: 'search' | 'articles' | 'sources';
}
const { current } = Astro.props;
---

<nav class="wb-tabs" aria-label="Views">
	<a
		class:list={['wb-tab', { active: current === 'search' }]}
		href="/"
		aria-current={current === 'search' ? 'page' : undefined}>Search</a
	>
	<a
		class:list={['wb-tab', { active: current === 'articles' }]}
		href="/articles/"
		aria-current={current === 'articles' ? 'page' : undefined}>Articles</a
	>
	<a
		class:list={['wb-tab', { active: current === 'sources' }]}
		href="/sources/"
		aria-current={current === 'sources' ? 'page' : undefined}>Sources</a
	>
</nav>

---
import Base from '../../layouts/Base.astro';
import { getArticles, excerpt, stripLeadingTitle, type BeijertermArticle } from '../../lib/articles';

// Statically prerender one page per published article. The feed is fetched at
// build time; if it's empty/unreachable, no article pages are emitted (and
// /articles/* 404s) — the build still succeeds.
export async function getStaticPaths() {
	const articles = await getArticles();
	return articles.map((article) => ({
		params: { slug: article.slug },
		props: { article },
	}));
}

const { article } = Astro.props as { article: BeijertermArticle };

const LANG_LABELS: Record<string, string> = {
	nl: 'Dutch', en: 'English', de: 'German', fr: 'French', es: 'Spanish',
	it: 'Italian', pt: 'Portuguese', pl: 'Polish', ru: 'Russian', la: 'Latin',
};
const langLabel = article.lang ? (LANG_LABELS[article.lang] || article.lang.toUpperCase()) : '';

// Each table goes in a box that scrolls sideways, so a wide one (the artrose
// article has six columns) doesn't widen the page on a phone.
const body = stripLeadingTitle(article.html, article.title)
	.replace(/<table\b/gi, '<div class="bt-table-wrap"><table')
	.replace(/<\/table>/gi, '</table></div>');

const metaDesc =
	excerpt(article.html, 155) ||
	`Beijer Dictionary terminology article: ${article.headword}.`;

// schema.org DefinedTerm — helps search engines understand this is a
// terminology entry (can earn richer results). termCode carries the headword.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'DefinedTerm',
	name: article.headword || article.title,
	description: metaDesc,
	termCode: article.headword || undefined,
	inDefinedTermSet: 'https://beijerdictionary.com/articles/',
	url: `https://beijerdictionary.com/articles/${article.slug}/`,
};
---

<Base title={`${article.title} — Beijer Dictionary`} description={metaDesc}>
	<article class="bt-article">
		<p class="bt-article-kicker">
			<a href="/articles/">Articles</a>
			{article.domain && <span class="bt-article-domain">{article.domain}</span>}
			{langLabel && <span class="bt-article-lang">{langLabel}</span>}
		</p>

		<h1>{article.title}</h1>

		<div class="bt-article-body" set:html={body}></div>

		<p class="bt-article-back">
			<a href="/articles/">← All articles</a> · <a href="/">Search</a>
		</p>
	</article>

	<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Base>

<style>
	.bt-article {
		max-width: 44em;
		line-height: 1.7;
	}
	.bt-article-kicker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em;
		margin: 0 0 0.4em;
		font-size: 0.85em;
	}
	.bt-article-domain,
	.bt-article-lang {
		display: inline-block;
		padding: 0.1em 0.55em;
		border: 1px solid rgb(var(--border));
		border-radius: 999px;
		color: rgb(var(--muted));
		font-size: 0.92em;
	}
	/* The article's term in the book serif, like headwords in search results. */
	.bt-article h1 {
		font-family: var(--serif);
		font-size: 1.85em;
		font-weight: 600;
		margin: 0 0 0.6em;
	}
	/* The body is author-written HTML (Tiptap) injected via set:html. Long
	   links (IATE URLs) must wrap, or they widen the page on a phone. */
	.bt-article-body { overflow-wrap: anywhere; }
	.bt-article-body :global(h2) { margin-top: 1.5em; font-size: 1.25em; }
	.bt-article-body :global(h3) { margin-top: 1.2em; font-size: 1.1em; }
	.bt-article-body :global(p) { margin: 0.6em 0; }
	.bt-article-body :global(ul),
	.bt-article-body :global(ol) { margin: 0.6em 0; padding-left: 1.3em; }
	.bt-article-body :global(li) { margin: 0.3em 0; }
	.bt-article-body :global(blockquote) {
		margin: 0.8em 0;
		padding-left: 1em;
		border-left: 3px solid rgb(var(--border));
		color: rgb(var(--muted));
	}
	.bt-article-body :global(code) {
		background: var(--subtle);
		padding: 0.1em 0.35em;
		border-radius: 4px;
		font-size: 0.9em;
	}
	.bt-article-body :global(img) { max-width: 100%; height: auto; }
	/* Tables: mostly example sentences (Dutch | English | Source). Without
	   these rules the browser put no space between columns, so a row read as
	   one run-on sentence, and centred the headings over left-aligned text. */
	.bt-article-body :global(.bt-table-wrap) { overflow-x: auto; margin: 0.9em 0; }
	.bt-article-body :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.92em;
		line-height: 1.5;
		/* Not "anywhere" (the body's setting): in a table that lets columns
		   shrink until words break letter by letter. */
		overflow-wrap: break-word;
	}
	.bt-article-body :global(th),
	.bt-article-body :global(td) {
		padding: 0.5em 0.7em;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid rgb(var(--border));
	}
	.bt-article-body :global(:is(th, td):first-child) { padding-left: 0; }
	.bt-article-body :global(:is(th, td):last-child) { padding-right: 0; }
	.bt-article-body :global(th) {
		font-weight: 600;
		color: rgb(var(--muted));
		font-size: 0.85em;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	/* Each cell's text sits in its own <p> (or list): no extra space above or below. */
	.bt-article-body :global(:is(th, td) > :first-child) { margin-top: 0; }
	.bt-article-body :global(:is(th, td) > :last-child) { margin-bottom: 0; }
	.bt-article-body :global(:is(th, td) :is(ul, ol)) { padding-left: 1.1em; }
	.bt-article-body :global(:is(th, td) li) { margin: 0.15em 0; }
	/* A full URL as a source shouldn't make its column as wide as the URL. */
	.bt-article-body :global(:is(th, td) a) { overflow-wrap: anywhere; }
	.bt-article-body :global(a) { color: rgb(var(--accent)); }
	.bt-article-back {
		margin-top: 2.2em;
		padding-top: 1em;
		border-top: 1px solid rgb(var(--border));
		font-weight: 600;
	}
</style>

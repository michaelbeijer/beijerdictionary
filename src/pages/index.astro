---
import Base from '../layouts/Base.astro';
import SourcesTable from '../components/SourcesTable.astro';
import { getArticles, toIndexItem } from '../lib/articles';

// Search API base. Production sets PUBLIC_WORDBOOK_API to the deployed Worker
// URL; in `astro dev` it falls back to a local Worker on :8787. The terminology
// data is never shipped to the browser — only per-query result snippets.
const apiBase = (
	import.meta.env.PUBLIC_WORDBOOK_API ||
	(import.meta.env.DEV ? 'http://127.0.0.1:8787' : '')
).replace(/\/$/, '');

// Compact article index, built from the beijer.ink feed at build time and
// embedded below. Unlike the term corpus (server-only, per-query snippets),
// articles are the owner's own original content, so shipping this small index
// (headword/aliases/domain/excerpt — no full bodies) to the browser is fine and
// lets article cards surface instantly client-side, with no extra API call.
const articleIndex = (await getArticles()).map(toIndexItem);
---

<Base
	title="Beijer Dictionary – multilingual terminology for technical translators"
	description="A curated, searchable multilingual terminology database for technical translators – Dutch ↔ English and more, with full provenance."
>
	<section class="wb-hero wb-hero--home">
		<!-- The header wordmark is the visible title; this heading is for
		     search engines and screen readers, so the name shows only once. -->
		<h1 class="sr-only">Beijer Dictionary</h1>
		<p class="wb-tag">
			A curated, searchable multilingual terminology database for technical
			translators – with full provenance for every source.
		</p>
	</section>

	<section class="wb-view">
		<div class="wb-search">
			<label class="sr-only" for="wb-q">Search Beijer Dictionary</label>
			<input id="wb-q" type="search" placeholder="Type a term…" title="Tip: press / anywhere on the page to jump back to this box" autocomplete="off" spellcheck="false" autocapitalize="off" inputmode="search" />
			<div class="wb-controls">
				<label class="sr-only" for="wb-from">From language</label>
				<select id="wb-from" class="wb-lang" aria-label="From language"></select>
				<button id="wb-swap" type="button" class="wb-swap" aria-label="Swap languages">⇄</button>
				<label class="sr-only" for="wb-to">To language</label>
				<select id="wb-to" class="wb-lang" aria-label="To language"></select>
			</div>
			<!-- Phones only: the options below fold away behind this button. -->
			<button id="wb-opts-toggle" type="button" class="wb-opts-toggle" aria-expanded="false" aria-controls="wb-opts">Search options</button>
			<div id="wb-opts" class="wb-opts">
				<span class="wb-opts-label">Search in:</span>
				<label><input type="checkbox" id="opt-in-terms" checked /> terms</label>
				<label><input type="checkbox" id="opt-in-def" /> definitions</label>
				<label><input type="checkbox" id="opt-in-notes" /> notes</label>
				<span class="wb-opts-sep" aria-hidden="true"></span>
				<label><input type="checkbox" id="opt-exact" /> Exact match</label>
				<label><input type="checkbox" id="opt-case" /> Case-sensitive</label>
				<label><input type="checkbox" id="opt-accent" /> Accent-sensitive</label>
				<label><input type="checkbox" id="opt-whole" /> Whole word</label>
				<span class="wb-opts-sep" aria-hidden="true"></span>
				<span class="wb-opts-label">Only entries with:</span>
				<label><input type="checkbox" id="opt-has-abbr" /> abbreviation</label>
				<label><input type="checkbox" id="opt-has-def" /> definition</label>
				<label><input type="checkbox" id="opt-has-notes" /> notes</label>
			</div>
			<div id="wb-counts" class="wb-counts">Loading…</div>
		</div>
		<div id="wb-results" class="wb-results" hidden></div>
	</section>

	<!-- The source detail dialog, opened by the source chips on result cards
	     (the list itself is on the Sources tab, /sources). -->
	<SourcesTable list={false} />
</Base>

<script type="application/json" id="bt-articles-data" is:inline set:html={JSON.stringify(articleIndex)}></script>

<script define:vars={{ apiBase }}>
	// ────────────────────────────────────────────────────────────────────
	// Beijer Dictionary search — server-side via the Cloudflare Worker + D1 API.
	//
	// The browser NEVER receives the dataset. On load it fetches /meta (the
	// source inventory + language pairs), and on each keystroke it fetches
	// /search?q=… which returns only the matching entries. Results are grouped
	// client-side into one card per headword for the chosen direction, plus one
	// card per matching multilingual concept (see renderConceptCard).
	// ────────────────────────────────────────────────────────────────────

	// How many headword CARDS to render. Distinct from how many entry rows we
	// ask the API for: a card absorbs many rows (searching "terminal" en→nl
	// folds ~80 rows into one card), so fetching only as many rows as we render
	// cards starved the common words of their equivalents.
	const MAX_RESULTS = 50;
	const FETCH_LIMIT = 200;   // entry rows per query; Worker caps at 300
	const DEBOUNCE_MS = 180;

	// Admin mode (Michael only) — same gate as the footer Admin link in
	// Base.astro: visit ?admin once to enable it on this browser, ?admin=off to
	// disable. When on, each result shows an Edit pencil that deep-links to the
	// LOCAL admin app (only reachable on his machine). The public never sees it.
	const ADMIN_BASE = 'http://127.0.0.1:8765';
	let ADMIN = false;
	try {
		const ap = new URLSearchParams(location.search);
		if (ap.has('admin')) {
			if (ap.get('admin') === 'off') localStorage.removeItem('bt-admin');
			else localStorage.setItem('bt-admin', '1');
		}
		ADMIN = localStorage.getItem('bt-admin') === '1';
	} catch (e) { /* private mode / no storage — stay public */ }

	const LANG_LABELS = {
		nl: 'Dutch', en: 'English', de: 'German', fr: 'French',
		es: 'Spanish', it: 'Italian', pt: 'Portuguese', pl: 'Polish',
		ru: 'Russian', sv: 'Swedish', no: 'Norwegian', da: 'Danish',
		fi: 'Finnish', cs: 'Czech', ja: 'Japanese', zh: 'Chinese',
		la: 'Latin',
		any: 'Any',
	};
	const langName = (c) => LANG_LABELS[c] || (c || '').toUpperCase();

	const fold = (s) =>
		s == null ? '' : s.normalize('NFKD').replace(/\p{M}/gu, '').toLowerCase();

	const escapeHtml = (s) =>
		(s ?? '').replace(/[&<>"']/g, (c) => ({
			'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
		}[c]));

	// Position-preserving fold: the folded string plus a map from each folded
	// char index back to the original char index, so a match found in the folded
	// form can be highlighted in the original text (accents/ligatures included).
	function foldMap(s) {
		let folded = '';
		const map = [];
		for (let i = 0; i < s.length; i++) {
			const f = s[i].normalize('NFKD').replace(/\p{M}/gu, '').toLowerCase();
			for (let j = 0; j < f.length; j++) { folded += f[j]; map.push(i); }
		}
		return { folded, map };
	}
	const _isWord = (ch) => !!ch && /[\p{L}\p{N}]/u.test(ch);

	// Highlight whole words that start with any search token (accent/case-folded),
	// mirroring the FTS prefix-at-word-start match. Returns { html, hit }.
	function hl(text, tokens) {
		if (!text) return { html: '', hit: false };
		if (!tokens || !tokens.length) return { html: escapeHtml(text), hit: false };
		const { folded, map } = foldMap(text);
		const ranges = [];
		for (const tok of tokens) {
			if (!tok) continue;
			let from = 0, idx;
			while ((idx = folded.indexOf(tok, from)) !== -1) {
				from = idx + tok.length;
				if (idx > 0 && _isWord(folded[idx - 1])) continue;   // word-start only
				// Mark only the typed characters, not the rest of the word.
				const e = idx + tok.length;
				ranges.push([map[idx], e - 1 < map.length ? map[e - 1] + 1 : text.length]);
			}
		}
		if (!ranges.length) return { html: escapeHtml(text), hit: false };
		ranges.sort((a, b) => a[0] - b[0]);
		const merged = [ranges[0]];
		for (let k = 1; k < ranges.length; k++) {
			const last = merged[merged.length - 1];
			if (ranges[k][0] <= last[1]) last[1] = Math.max(last[1], ranges[k][1]);
			else merged.push(ranges[k]);
		}
		let out = '', pos = 0;
		for (const [s, e] of merged) {
			out += escapeHtml(text.slice(pos, s)) + '<mark>' + escapeHtml(text.slice(s, e)) + '</mark>';
			pos = e;
		}
		out += escapeHtml(text.slice(pos));
		return { html: out, hit: true };
	}

	// State
	let meta = { sources: [], lang_pairs: [], counts: { sources: 0, entries: 0 } };
	let direction = null;        // {src, tgt}
	let lastEntries = [];        // raw results from the last /search
	let lastSenses = [];         // consolidated sense groups from the last /search
	let lastConcepts = [];       // multilingual concepts from the last /search
	let lastQuery = '';
	let searchAbort = null;
	let debounceTimer = null;

	async function getJSON(path, signal) {
		const r = await fetch(apiBase + path, { signal, headers: { Accept: 'application/json' } });
		if (!r.ok) throw new Error('API returned ' + r.status);
		return r.json();
	}

	// Search-option checkboxes. The toggle group changes what the API returns,
	// so flipping any of them re-runs the search (not just a client re-render).
	const HAS_IDS = { abbr: 'opt-has-abbr', def: 'opt-has-def', notes: 'opt-has-notes' };
	const SCOPE_IDS = { terms: 'opt-in-terms', def: 'opt-in-def', notes: 'opt-in-notes' };
	const OPT_IDS = [...Object.values(SCOPE_IDS), 'opt-exact', 'opt-case', 'opt-accent',
		'opt-whole', ...Object.values(HAS_IDS)];
	const isOn = (id) => { const el = document.getElementById(id); return !!(el && el.checked); };

	// Build the &-prefixed query fragment from the current option state.
	function optsQuery() {
		const p = [];
		// "Search in" scope (defaults to terms only when nothing is ticked).
		const fields = Object.entries(SCOPE_IDS).filter(([, id]) => isOn(id)).map(([k]) => k);
		if (fields.length) p.push('fields=' + fields.join(','));
		if (isOn('opt-exact')) p.push('exact=1');
		if (isOn('opt-whole')) p.push('whole=1');
		if (isOn('opt-case')) p.push('case=1');
		if (isOn('opt-accent')) p.push('accent=1');
		const has = Object.entries(HAS_IDS).filter(([, id]) => isOn(id)).map(([k]) => k);
		if (has.length) p.push('has=' + has.join(','));
		return p.length ? '&' + p.join('&') : '';
	}

	function saveOpts() {
		try {
			const state = {};
			OPT_IDS.forEach((id) => { state[id] = isOn(id); });
			localStorage.setItem('bt-search-opts', JSON.stringify(state));
		} catch { /* ignore */ }
	}
	function loadOpts() {
		try {
			const state = JSON.parse(localStorage.getItem('bt-search-opts') || '{}');
			Object.entries(state).forEach(([id, v]) => {
				const el = document.getElementById(id);
				if (el) el.checked = !!v;
			});
		} catch { /* ignore */ }
		updateOptsToggle();
	}

	// On a phone the options fold away behind a button. Options are remembered
	// on each device, so the button says how many differ from the default:
	// otherwise a box ticked on an earlier visit would change results unseen.
	function updateOptsToggle() {
		const btn = document.getElementById('wb-opts-toggle');
		const changed = OPT_IDS.filter((id) => {
			const el = document.getElementById(id);
			return el && el.checked !== el.defaultChecked;
		}).length;
		btn.textContent = changed ? `Search options (${changed} changed)` : 'Search options';
	}
	document.getElementById('wb-opts-toggle').addEventListener('click', (ev) => {
		const open = document.getElementById('wb-opts').classList.toggle('open');
		ev.currentTarget.setAttribute('aria-expanded', String(open));
	});

	function discoverDirections(pairs) {
		const dirs = [];
		for (const p of pairs) {
			dirs.push({ src: p.a, tgt: p.b });
			dirs.push({ src: p.b, tgt: p.a });
		}
		const seen = new Set();
		return dirs.filter((d) => {
			const k = d.src + '>' + d.tgt;
			if (seen.has(k)) return false;
			seen.add(k);
			return true;
		});
	}

	// Decide how an entry maps onto the chosen direction: which side is the
	// headword, which is the equivalent. Honours an "any" wildcard on either
	// side. Returns null if the entry doesn't belong in this direction.
	function orientForDirection(e, dir) {
		const src = dir.src, tgt = dir.tgt;
		const anyS = src === 'any', anyT = tgt === 'any';
		const mono = !e.b || !e.lb;
		// `hLang` is the language of the headword side — used to label a
		// definition that arrives with no equivalent ("English definition …").
		if (mono) {
			// Monolingual entry (term + definition, no second-language equivalent):
			// show it whenever its single language is on either side (or Any).
			if (anyS || anyT || e.la === src || e.la === tgt) {
				return { head: e.a, qHead: e.qa, hLang: e.la, headSide: 'a', equiv: null, qEquiv: null, mono: true };
			}
			return null;
		}
		// `headSide` says which column the headword came from, so the caller can
		// pick the sense group consolidated for THAT side (sga vs sgb).
		const asA = { head: e.a, qHead: e.qa, hLang: e.la, headSide: 'a', equiv: e.b, qEquiv: e.qb, mono: false };
		const asB = { head: e.b, qHead: e.qb, hLang: e.lb, headSide: 'b', equiv: e.a, qEquiv: e.qa, mono: false };
		if (anyS && anyT) return asA;
		if (!anyS && !anyT) {
			if (e.la === src && e.lb === tgt) return asA;
			if (e.la === tgt && e.lb === src) return asB;
			return null;
		}
		// Exactly one side is "any"; L is the concrete language.
		const L = anyS ? tgt : src;
		if (anyT) {
			// src = L, tgt = Any → the L side is the headword.
			if (e.la === L) return asA;
			if (e.lb === L) return asB;
		} else {
			// src = Any, tgt = L → the L side is the equivalent, the other the headword.
			if (e.lb === L) return asA;
			if (e.la === L) return asB;
		}
		return null;
	}

	// Group a flat entry list into ordered headword cards for a direction.
	// Insertion order preserves the server's bm25 ranking.
	function groupForDirection(entries, dir, senses) {
		// Consolidated senses (Phase 2): map sense-group id → { label, no, dom }.
		// When an entry carries a sense id (e.sg), its translation line is keyed by
		// the sense and labelled with the clean English sense label instead of the
		// raw qualifier — collapsing the per-(qualifier, source) fragments into one
		// line per meaning. Entries without a sense fall back to the legacy keying.
		const senseById = new Map((senses || []).map((s) => [s.id, s]));
		const index = new Map();
		const order = [];
		for (const e of entries) {
			const o = orientForDirection(e, dir);
			if (!o) continue;
			const { head, qHead, hLang, headSide, equiv, qEquiv, mono } = o;
			if (!head || (!mono && !equiv)) continue;
			const hf = fold(head);
			let g = index.get(hf);
			if (!g) {
				g = {
					display: head, headFold: hf, headLang: hLang || '',
					// Equivalents are bucketed into LINES keyed by (sense, source) —
					// sense = the headword-side qualifier (e.g. "toerekening (van
					// baten in de tijd)"), source = the dictionary it came from. So a
					// polysemous headword keeps its glosses instead of flattening
					// every translation into one list, and when several sources share
					// a headword each keeps its own provenance (source + domain)
					// instead of one misleading card-level label. Insertion order ≈
					// bm25 rank.
					lines: new Map(),
					// Definitions are attributed TWICE over. Each distinct definition
					// is a block keyed by its text, carrying the notes, reference
					// link(s) and source(s) of the entries that share it — and it is
					// parked on the translation LINE whose entry carried it, so the
					// reader can see which meaning it defines instead of meeting a
					// loose paragraph at the foot of the card. `defBlocks` here holds
					// only the leftovers: definitions from entries that produced no
					// translation line at all (a monolingual glossary row — term +
					// definition, no equivalent), which are labelled as such.
					// `defOwner` maps a definition's text to wherever its block ended
					// up, so the same text arriving from several entries still merges
					// into one block rather than repeating down the card.
					defBlocks: new Map(), defOwner: new Map(),
					looseNotes: new Set(), looseLinks: new Set(),
					sources: new Set(), domains: new Set(),
					abbrs: new Set(), idBySource: new Map(),
				};
				index.set(hf, g);
				order.push(g);
			}
			// The line this entry contributes to, if any. A definition on the same
			// entry is attributed to that line below, instead of floating card-level.
			let ownLine = null;
			if (equiv) {
				// Take the sense group consolidated for the side the headword is
				// on. An entry carries one per side — "plaat | plate" belongs to a
				// sense of Dutch *plaat* AND to a sense of English *plate* — and
				// only the one whose headword matches this card describes what's
				// on screen; the other would label an English card with the Dutch
				// sense partition. (`sg` is the pre-sides field: always a-side.)
				const sgId = headSide === 'b' ? e.sgb : (e.sga != null ? e.sga : e.sg);
				const sense = (sgId != null) ? senseById.get(sgId) : null;
				const lk = sense ? ('sg:' + sense.id) : ((qHead || '') + '' + (e.src || ''));
				let ln = g.lines.get(lk);
				if (!ln) {
					ln = { qual: sense ? sense.label : (qHead || ''), srcKey: '', domains: new Set(), equivs: new Map(), id: null, senseNo: sense ? sense.no : null, isSense: !!sense, def: sense ? (sense.def || '') : '', defBlocks: new Map() };
					g.lines.set(lk, ln);
				}
				ownLine = ln;
				const ef = fold(equiv);
				if (!ln.equivs.has(ef)) ln.equivs.set(ef, { display: equiv, qEquiv: qEquiv || '' });
				if (e.dom) ln.domains.add(e.dom);
				if (e.src) { const _s = new Set(ln.srcKey ? ln.srcKey.split(',').map((x) => x.trim()) : []); e.src.split(',').forEach((x) => _s.add(x.trim())); ln.srcKey = [..._s].filter(Boolean).join(','); }
				if (ln.id == null && e.id != null) ln.id = e.id;
			}
			if (e.src) String(e.src).split(',').forEach((s) => {
				const slug = s.trim();
				g.sources.add(slug);
				// Remember which master entry contributed this source, so the
				// admin Edit pencil can deep-link straight to that exact entry.
				if (e.id != null) g.idBySource.set(slug, e.id);
			});
			if (e.dom) g.domains.add(e.dom);
			if (e.abbr) g.abbrs.add(e.abbr);
			// Per-entry reference URL(s). The field is free TEXT, so split on
			// whitespace and keep only real http(s) links.
			const eLinks = e.links
				? String(e.links).split(/\s+/).filter((u) => /^https?:\/\//i.test(u))
				: [];
			const eSrcs = e.src ? String(e.src).split(',').map((s) => s.trim()).filter(Boolean) : [];
			if (e.def) {
				// Attribute the definition: bucket by its text and fold in this
				// entry's notes, links and source(s). A first sighting is parked on
				// the translation line this same entry produced — that's what ties
				// the definition to a meaning. Only an entry with no line of its own
				// (a monolingual row: term + definition, no equivalent) leaves its
				// definition at card level, where it is labelled as such.
				const dk = fold(e.def);
				let blk = g.defOwner.get(dk);
				if (!blk) {
					blk = { def: e.def, notes: new Set(), links: new Set(), sources: new Set() };
					g.defOwner.set(dk, blk);
					(ownLine ? ownLine.defBlocks : g.defBlocks).set(dk, blk);
				}
				if (e.notes) blk.notes.add(e.notes);
				eLinks.forEach((u) => blk.links.add(u));
				eSrcs.forEach((s) => blk.sources.add(s));
			} else {
				// No definition → notes/links stay loose (shown card-level).
				if (e.notes) g.looseNotes.add(e.notes);
				eLinks.forEach((u) => g.looseLinks.add(u));
			}
		}
		for (const g2 of order) { g2.lines = new Map([...g2.lines.entries()].sort((a, b) => { const an = a[1].senseNo, bn = b[1].senseNo; if (an != null && bn != null) return an - bn; if (an != null) return -1; if (bn != null) return 1; return 0; })); }
		return order;
	}

	// Per-entry reference link(s) → 🔗 chips (e.g. the EU regulation a railway
	// term is defined in). Labelled by a friendly host name.
	function refLabel(url) {
		try {
			const h = new URL(url).hostname.replace(/^www\./, '');
			return /eur-lex\.europa\.eu$/i.test(h) ? 'EUR-Lex' : h;
		} catch { return 'link'; }
	}
	const refChip = (u) =>
		`<a class="pill pill-ref" href="${escapeHtml(u)}" target="_blank" rel="noopener noreferrer" title="${escapeHtml(u)}">🔗 ${escapeHtml(refLabel(u))}</a>`;

	function renderCard(group, tokens) {
		// Render one sense's equivalents (sorted) as a "· "-joined run of chips,
		// each optionally carrying its own equivalent-side qualifier.
		// The separator is a real element followed by a real space, not a CSS
		// ::before on a run of spans joined with nothing: without a space
		// somewhere the browser sees the whole run as ONE word and can only wrap
		// where an equivalent happens to contain a space of its own, so a long
		// run of single-word equivalents overflows the card. Keeping the "·"
		// glued to the chip before it (space only AFTER) means the break lands
		// between chips and no line ever starts with a stray separator.
		const renderEquivs = (equivs) => {
			const items = [...equivs.values()].sort((a, b) => a.display.localeCompare(b.display));
			return items.map(({ display, qEquiv }, i) => {
				const h = hl(display, tokens);
				const qSpan = qEquiv ? ` <span class="qual">(${escapeHtml(qEquiv)})</span>` : '';
				const sep = i < items.length - 1 ? '<span class="sep">·</span> ' : '';
				return `<span class="e${h.hit ? ' hit' : ''}">${h.html}${qSpan}</span>${sep}`;
			}).join('');
		};

		// A leading "(gloss)" prefix for a sense line (empty when ungloss­ed).
		const glossPrefix = (ln) => { if (!ln.qual) return ''; return ln.isSense ? `<span class="sense-num">${ln.dispNo}.</span> <b class="sense-label">${escapeHtml(ln.qual)}</b> ` : `<span class="sense-gloss">(${escapeHtml(ln.qual)})</span> `; };

		// A muted definition sub-line for a sense — the hand-curated gloss that
		// applies to the whole meaning. Shown only when a definition was written.
		const senseDef = (ln) => (ln && ln.def) ? `<div class="wb-sensedef">${escapeHtml(ln.def)}</div>` : '';

		const refChipsFrom = (set) => [...set].map(refChip).join(' ');

		// A source chip (opens the source's detail dialog via /#slug) + admin
		// Edit pencil. Reused by the
		// card meta row and to surface sources that contribute only a monolingual
		// entry (definition with no equivalent → no line of their own).
		const srcChip = (s) => {
			const chip = `<a class="pill pill-src" href="/#${encodeURIComponent(s)}" title="About this source">${escapeHtml(s)}</a>`;
			if (!ADMIN) return chip;
			const id = group.idBySource.get(s);
			const pencil = id != null
				? ` <a class="wb-edit" href="${ADMIN_BASE}/?edit=${id}" target="_blank" rel="noopener" title="Edit entry #${id} in the local admin">✎</a>`
				: '';
			return chip + pencil;
		};

		// Per-line provenance (source chip[s] + that line's domain), shown only on
		// multi-source cards so each translation is tied to where it came from.
		const renderProv = (line) => {
			const dom = [...line.domains][0];
			const domHtml = dom ? `<span class="wb-prov-dom">${escapeHtml(dom)}</span>` : '';
			const chips = (line.srcKey ? line.srcKey.split(',') : []).map((s) => s.trim()).filter(Boolean).map((s) => {
				const chip = `<a class="pill pill-src" href="/#${encodeURIComponent(s)}" title="About this source">${escapeHtml(s)}</a>`;
				if (!ADMIN) return chip;
				const pencil = line.id != null
					? ` <a class="wb-edit" href="${ADMIN_BASE}/?edit=${line.id}" target="_blank" rel="noopener" title="Edit entry #${line.id} in the local admin">✎</a>`
					: '';
				return chip + pencil;
			}).join(' ');
			return (domHtml || chips) ? ` <span class="wb-prov">${domHtml}${chips}</span>` : '';
		};

		// A small label naming the field a run of text came from. A definition and
		// its notes otherwise look alike (both muted prose under the same rule), so
		// the reader couldn't tell where one ended and the other began.
		const fieldLabel = (name) => `<span class="wb-field">${name}</span> `;

		// Render a run of attributed definition blocks: each definition with its
		// own notes, reference link(s) and source chip(s). `shownSrcs` lists the
		// sources already named on the parent translation line, so a nested
		// definition doesn't repeat a chip that sits an inch above it.
		// `labelDefs` is false where a section heading already says "definition".
		const renderDefBlocks = (blocks, cap, shownSrcs, labelDefs) => {
			const list = [...blocks];
			const body = list.slice(0, cap).map((blk) => {
				const dh = hl(blk.def, tokens);
				const noteHtml = [...blk.notes].slice(0, 2).map((n) => {
					const h = hl(n, tokens);
					return `<div class="wb-def-note${h.hit ? ' hit' : ''}">${fieldLabel('Note')}${h.html}</div>`;
				}).join('');
				const linkChips = refChipsFrom(blk.links);
				const unseen = [...blk.sources].filter((s) => !(shownSrcs && shownSrcs.has(s)));
				const srcChips = unseen.map(srcChip).join(' ');
				const prov = [srcChips, linkChips].filter(Boolean).join(' · ');
				return `<div class="wb-defblock"><div class="wb-def${dh.hit ? ' hit' : ''}">${labelDefs ? fieldLabel('Definition') : ''}${dh.html}</div>`
					+ noteHtml
					+ (prov ? `<div class="wb-def-prov">${prov}</div>` : '')
					+ '</div>';
			}).join('');
			const extra = list.length - cap;
			return body + (extra > 0
				? `<div class="wb-def-more">+${extra} more definition${extra === 1 ? '' : 's'}</div>`
				: '');
		};

		// The definitions belonging to one translation line, shown indented
		// directly beneath it so it's unambiguous which meaning they define.
		const lineDefs = (ln) => {
			if (!ln || !ln.defBlocks || !ln.defBlocks.size) return '';
			const own = new Set((ln.srcKey ? ln.srcKey.split(',') : []).map((s) => s.trim()).filter(Boolean));
			return `<div class="wb-linedefs">${renderDefBlocks(ln.defBlocks.values(), 3, own, true)}</div>`;
		};

		// Lines that actually have translations, keyed by (sense, source).
		const lines = [...group.lines.values()].filter((l) => l.equivs.size);
		let _sn = 0; lines.forEach((l) => { if (l.isSense) l.dispNo = ++_sn; });
		const multiSrc = group.sources.size > 1;

		// Sources that appear on a translation line (so they're attributed there).
		const lineSrcs = new Set();
		lines.forEach((l) => (l.srcKey ? l.srcKey.split(',') : []).forEach((s) => lineSrcs.add(s.trim())));

		let equivBlock = '';
		if (multiSrc) {
			// Several sources share this headword → one line per (sense, source),
			// each tagged with its own provenance so chip↔translation is unambiguous.
			// Each line and its definitions are wrapped as one block, so a faint rule
			// can separate them: a chip that wraps onto its own row would otherwise
			// sit just as close to the next source's line as to its own.
			equivBlock = lines.map((l) =>
				`<div class="wb-srcblock"><div class="wb-equivs wb-sense">${glossPrefix(l)}<span class="arrow">→</span>${renderEquivs(l.equivs)}${renderProv(l)}</div>${senseDef(l)}${lineDefs(l)}</div>`
			).join('');
		} else if (lines.length === 1) {
			// Single source, single sense → gloss sits inline on the headword.
			equivBlock = `<div class="wb-equivs"><span class="arrow">→</span>${renderEquivs(lines[0].equivs)}</div>${senseDef(lines[0])}${lineDefs(lines[0])}`;
		} else if (lines.length > 1) {
			// Single source, several senses → one arrow-line per gloss.
			equivBlock = lines.map((l) =>
				`<div class="wb-equivs wb-sense">${glossPrefix(l)}<span class="arrow">→</span>${renderEquivs(l.equivs)}</div>${senseDef(l)}${lineDefs(l)}`
			).join('');
		}

		// What's left after every definition that belongs to a translation line has
		// been rendered under it: definitions from entries that carry no equivalent
		// at all (a monolingual glossary row, e.g. ERA-Railway's English-only
		// railway definitions). They have no meaning on this card to attach to, so
		// say so plainly rather than leaving the reader to guess which term above
		// they define.
		const DEF_CAP = 4;
		const orphanDefs = [...group.defBlocks.values()];
		// Sources named on ANY definition block, wherever it ended up — used below
		// to decide which sources still need a chip of their own.
		const defSrcs = new Set();
		[...group.defOwner.values()].forEach((b) => b.sources.forEach((s) => defSrcs.add(s)));
		let defHtml = '';
		if (orphanDefs.length) {
			const lang = group.headLang ? langName(group.headLang) + ' ' : '';
			const plural = orphanDefs.length === 1 ? '' : 's';
			// On a card that also has translations, the point of the label is that
			// THESE definitions came without one. On an all-monolingual card there's
			// nothing to contrast with, so just name the section.
			const label = lines.length
				? `${lang}definition${plural} · no equivalent in this source`
				: `${lang}definition${plural}`;
			// A single-source card already names its source in the meta row.
			const shown = multiSrc ? null : group.sources;
			defHtml = `<div class="wb-orphandefs">`
				+ `<div class="wb-def-label">${escapeHtml(label)}</div>`
				+ renderDefBlocks(group.defBlocks.values(), DEF_CAP, shown, false)
				+ `</div>`;
		}

		// Notes from entries with NO definition stay loose (shown card-level).
		const looseNotes = [...group.looseNotes];
		const notesHtml = looseNotes.length
			? '<div class="wb-notes">' + looseNotes.slice(0, 2).map((n) => {
					const h = hl(n, tokens);
					return '<span class="n' + (h.hit ? ' hit' : '') + '">' + fieldLabel('Note') + h.html + '</span>';
			  }).join('') + (looseNotes.length > 2 ? ' <span class="n-more">+' + (looseNotes.length - 2) + ' more</span>' : '') + '</div>'
			: '';
		const looseLinkChips = refChipsFrom(group.looseLinks);

		// Card-level metadata row: domain + source chips + any loose links. Shown
		// only on single-source cards — multi-source cards carry provenance per
		// line / per definition block instead.
		const meta_ = multiSrc ? '' : [
			...[...group.domains].slice(0, 1).map(escapeHtml),
			...[...group.sources].map(srcChip),
			...(looseLinkChips ? [looseLinkChips] : []),
		].join(' · ');

		// Multi-source trailing row: only for sources NOT already attributed inline
		// (neither a translation line nor a definition block) + any loose links.
		const orphanSrcs = [...group.sources].filter((s) => s && !lineSrcs.has(s) && !defSrcs.has(s));
		const refsRow = (multiSrc && (orphanSrcs.length || looseLinkChips))
			? `<div class="wb-card-meta">${[...orphanSrcs.map(srcChip), ...(looseLinkChips ? [looseLinkChips] : [])].join(' · ')}</div>`
			: '';

		// The headword carries its gloss inline only on a single-source, single-sense
		// card (otherwise each gloss sits on its own arrow-line). Fall back to the
		// first line's gloss for monolingual / no-equivalent cards.
		const allLines = [...group.lines.values()];
		const headLine = (!multiSrc && lines.length === 1) ? lines[0]
			: (lines.length === 0 && allLines.length === 1 ? allLines[0] : null);
		const qH = headLine && headLine.qual ? ` <span class="qual">(${escapeHtml(headLine.qual)})</span>` : '';
		// Show the abbreviation chip, unless it's identical to the headword
		// (a standalone acronym entry, e.g. "FOG", carries itself as its abbr).
		const abbrHtml = [...group.abbrs]
			.filter((x) => fold(x) !== group.headFold)
			.map((x) => ` <span class="wb-abbr" title="Abbreviation">${escapeHtml(x)}</span>`).join('');
		return `<article class="wb-card">
			<div class="wb-headword">${hl(group.display, tokens).html}${qH}${abbrHtml}</div>
			${equivBlock}
			${defHtml}
			${notesHtml}
			${meta_ ? `<div class="wb-card-meta">${meta_}</div>` : ''}
			${refsRow}
		</article>`;
	}

	// ── Multilingual concepts ─────────────────────────────────────────────
	// A concept is one row of a multilingual source (EuroVoc, the textile
	// glossary, …) kept whole: every term in every language, as the source
	// listed them. It is drawn as ONE card instead of being cut into language
	// pairs, because pairing each synonym with each synonym invented
	// translations the source never gave ("to betray" → "in de steek laten").
	// A synonym list says the words belong together, not which word translates
	// which, so the card shows each language's list whole.

	// Terms shown per language before "+N more".
	const CONCEPT_TERMS_SHOWN = 8;

	// Like an entry, a concept belongs in a direction only if it has a term in
	// each concrete language of it.
	function conceptFits(c, dir) {
		const has = (l) => l === 'any' || !!(c.terms[l] && c.terms[l].length);
		return has(dir.src) && has(dir.tgt);
	}

	// The card is headed in the From language, or with From = Any in the
	// language of the term that matched.
	function conceptHeadLang(c, dir) {
		if (dir.src !== 'any' && c.terms[dir.src]) return dir.src;
		if (c.hit && c.hit.lang && c.terms[c.hit.lang]) return c.hit.lang;
		return c.langs.find((l) => c.terms[l]) || Object.keys(c.terms)[0];
	}

	function renderConceptCard(c, dir, tokens) {
		const termHtml = (x) => {
			const h = hl(x.t, tokens);
			const q = x.q ? ` <span class="qual">(${escapeHtml(x.q)})</span>` : '';
			return `<span class="e${h.hit ? ' hit' : ''}">${h.html}${q}</span>`;
		};
		// A language's terms in the source's order, the first few inline and the
		// rest behind "+N more".
		const termRun = (list) => {
			const sep = '<span class="sep">·</span> ';
			const shown = list.slice(0, CONCEPT_TERMS_SHOWN).map(termHtml).join(sep);
			const rest = list.slice(CONCEPT_TERMS_SHOWN);
			return rest.length
				? `${shown}${sep}<details class="wb-more-terms"><summary>+${rest.length} more</summary>${rest.map(termHtml).join(sep)}</details>`
				: shown;
		};
		const line = (label, list, target) =>
			`<div class="wb-equivs wb-concept-line${target ? ' wb-concept-target' : ''}"><span class="wb-concept-lang">${target ? '<span class="arrow">→</span>' : ''}${label}</span><span class="wb-concept-terms">${termRun(list)}</span></div>`;
		const langLine = (l, target) => line(escapeHtml(langName(l)), c.terms[l], target);

		const head = conceptHeadLang(c, dir);
		const headTerms = c.terms[head] || [];
		const lead = headTerms[0] || { t: '' };
		const langs = c.langs.filter((l) => c.terms[l] && c.terms[l].length);

		// The term that matched, when it isn't the heading: it may sit far down a
		// list or in a folded-away language.
		const hit = c.hit && c.hit.t != null && !(c.hit.lang === head && fold(c.hit.t) === fold(lead.t))
			? `<div class="wb-concept-hit">matched: <b>${hl(c.hit.t, tokens).html}</b>${c.hit.lang !== head ? ` <span class="wb-concept-hitlang">(${escapeHtml(langName(c.hit.lang))})</span>` : ''}</div>`
			: '';
		// The heading language's other terms.
		const also = headTerms.length > 1 ? line('also', headTerms.slice(1)) : '';
		// The target language in full; with To = Any every other language, and
		// otherwise the remaining languages folded away.
		const others = langs.filter((l) => l !== head && l !== dir.tgt);
		let body = '';
		if (dir.tgt !== 'any' && dir.tgt !== head) {
			body = langLine(dir.tgt, true);
			if (others.length) {
				body += `<details class="wb-concept-more"><summary>${others.length} more language${others.length === 1 ? '' : 's'}</summary>${others.map((l) => langLine(l)).join('')}</details>`;
			}
		} else {
			body = others.map((l) => langLine(l)).join('');
		}

		const def = c.def ? `<div class="wb-def${hl(c.def, tokens).hit ? ' hit' : ''}"><span class="wb-field">Definition</span> ${hl(c.def, tokens).html}</div>` : '';
		const notes = c.notes ? `<div class="wb-notes"><span class="n">${'<span class="wb-field">Note</span> ' + hl(c.notes, tokens).html}</span></div>` : '';
		const links = c.links ? String(c.links).split(/\s+/).filter((u) => /^https?:\/\//i.test(u)).map(refChip).join(' ') : '';
		const src = `<a class="pill pill-src" href="/#${encodeURIComponent(c.src)}" title="About this source">${escapeHtml(c.src)}</a>`;
		const meta_ = [c.dom ? escapeHtml(c.dom) : '', src, links].filter(Boolean).join(' · ');

		// With one term per language the source has paired them itself. With
		// several, it only says the words belong together.
		const note = langs.some((l) => c.terms[l].length > 1)
			? '<div class="wb-concept-note">The source lists these words together as one entry. It doesn\'t say which word translates which.</div>'
			: '';

		return `<article class="wb-card wb-concept">
			<div class="wb-headword">${hl(lead.t, tokens).html}${lead.q ? ` <span class="qual">(${escapeHtml(lead.q)})</span>` : ''}<span class="wb-concept-badge" title="One entry of a multilingual source, shown with all its languages">${langs.length} languages</span></div>
			${hit}${also}${body}${def}${notes}${note}
			<div class="wb-card-meta">${meta_}</div>
		</article>`;
	}

	// ── Terminology articles ──────────────────────────────────────────────
	// The compact article index is embedded at build time (bt-articles-data);
	// article cards are matched and rendered entirely client-side. Unlike the
	// term corpus, articles are the owner's own original content.
	let ARTICLES = [];
	try {
		ARTICLES = JSON.parse(document.getElementById('bt-articles-data').textContent || '[]');
	} catch (e) { ARTICLES = []; }

	// An article matches when the folded query is a prefix of its headword,
	// title, or any alias (whole-string or at a word boundary) — mirroring the
	// term search's word-start prefix behaviour. Direction/lang filters don't
	// apply: an article surfaces whenever one of its terms matches.
	function matchArticles(query) {
		const q = fold((query || '').trim());
		if (q.length < 2 || !ARTICLES.length) return [];
		const hits = [];
		for (const a of ARTICLES) {
			const terms = [a.headword, a.title, ...(a.aliases || [])];
			let ok = false;
			for (const t of terms) {
				const ft = fold(t);
				if (!ft) continue;
				if (ft.startsWith(q) || ft.split(/[^\p{L}\p{N}]+/u).some((w) => w.startsWith(q))) {
					ok = true; break;
				}
			}
			if (ok) hits.push(a);
		}
		return hits.slice(0, 5);
	}

	function renderArticleCard(a, tokens) {
		const title = hl(a.title || a.headword || '', tokens).html;
		const domain = a.domain ? `<span class="wb-article-chip">${escapeHtml(a.domain)}</span>` : '';
		const lang = a.lang ? `<span class="wb-article-chip">${escapeHtml(a.lang.toUpperCase())}</span>` : '';
		const teaser = a.excerpt ? `<div class="wb-article-teaser">${escapeHtml(a.excerpt)}</div>` : '';
		return `<a class="wb-card wb-article" href="/articles/${encodeURIComponent(a.slug)}/">
			<div class="wb-article-top"><span class="wb-article-badge">Article</span>${domain}${lang}</div>
			<div class="wb-article-title">${title}</div>
			${teaser}
		</a>`;
	}

	// Order: the headword card for exactly what was typed, then concepts with a
	// term that is exactly it, then the other headword cards, then the other
	// concepts. A concept card never pushes the main answer down.
	function renderResults(groups, concepts, tokens, articles, query) {
		const box = document.getElementById('wb-results');
		articles = articles || [];
		const articleHtml = articles.map((a) => renderArticleCard(a, tokens)).join('');
		if (!groups.length && !concepts.length && !articles.length) {
			box.innerHTML = '<p class="wb-empty">No matches.</p>';
			box.hidden = false;
			return;
		}
		const qf = fold(query);
		const shown = groups.slice(0, MAX_RESULTS);
		const exactCards = shown.filter((g) => g.headFold === qf);
		const otherCards = shown.filter((g) => g.headFold !== qf);
		const exactConcepts = concepts.filter((c) => c.hit && c.hit.tier <= 1);
		const otherConcepts = concepts.filter((c) => !(c.hit && c.hit.tier <= 1));
		const card = (g) => renderCard(g, tokens);
		const conceptCard = (c) => renderConceptCard(c, direction, tokens);
		box.innerHTML = articleHtml
			+ exactCards.map(card).join('')
			+ exactConcepts.map(conceptCard).join('')
			+ otherCards.map(card).join('')
			+ otherConcepts.map(conceptCard).join('')
			+ (groups.length > MAX_RESULTS
				? `<div class="wb-more">Showing ${MAX_RESULTS} of ${groups.length} headwords.</div>`
				: '');
		box.hidden = false;
	}

	// Adjacency map: source-lang → sorted list of target-langs it pairs with.
	// Built from the discovered directions so the To dropdown only ever offers
	// languages that actually have data with the chosen From language.
	function langAdjacency() {
		const adj = new Map();
		for (const d of discoverDirections(meta.lang_pairs || [])) {
			if (!adj.has(d.src)) adj.set(d.src, new Set());
			adj.get(d.src).add(d.tgt);
		}
		return adj;
	}

	const byName = (a, b) => langName(a).localeCompare(langName(b));

	// Every language that appears in any pair (for the "Any" From dropdown).
	function allLangs() {
		const s = new Set();
		for (const p of meta.lang_pairs || []) { s.add(p.a); s.add(p.b); }
		return [...s];
	}

	// Populate the From/To dropdowns to reflect `direction`. Both dropdowns lead
	// with an "Any" option (no language filter on that side). A concrete From
	// restricts To to languages it actually pairs with; an "Any" From offers all.
	function updateDirControls() {
		const fromSel = document.getElementById('wb-from');
		const toSel = document.getElementById('wb-to');
		const adj = langAdjacency();
		const langs = allLangs().sort(byName);
		if (!langs.length) return;
		const opt = (c) => `<option value="${c}">${escapeHtml(langName(c))}</option>`;

		if (!direction) direction = { src: 'nl', tgt: 'en' };

		const froms = ['any', ...langs];
		if (!froms.includes(direction.src)) direction.src = froms[0];
		fromSel.innerHTML = froms.map(opt).join('');
		fromSel.value = direction.src;

		const tos = direction.src === 'any'
			? ['any', ...langs]
			: ['any', ...[...(adj.get(direction.src) || [])].sort(byName)];
		if (!tos.includes(direction.tgt)) {
			direction.tgt = (tos.includes('en') && direction.src !== 'en') ? 'en' : tos[0];
		}
		toSel.innerHTML = tos.map(opt).join('');
		toSel.value = direction.tgt;

		const input = document.getElementById('wb-q');
		if (input && direction) {
			// Say what to type, not the direction: the language menus right
			// below already show that. No "(press /)" either: newcomers read it
			// as "type a slash". The shortcut is in the box's tooltip instead.
			const name = langName(direction.src);
			input.placeholder = direction.src === 'any'
				? 'Type a term in any language…'
				: `Type ${/^[AEIOU]/.test(name) ? 'an' : 'a'} ${name} term…`;
		}
	}

	function updateCounts(resultCount) {
		const counts = document.getElementById('wb-counts');
		const sN = meta.counts.sources || 0;
		const eN = meta.counts.entries || 0;
		// "N sources" links to the Sources page.
		const link = document.createElement('a');
		link.href = '/sources/';
		link.textContent = `${sN.toLocaleString('en-GB')} source${sN === 1 ? '' : 's'}`;
		const cN = meta.counts.concepts || 0;
		let s = ` · ${eN.toLocaleString('en-GB')} entries`;
		if (cN) s += ` · ${cN.toLocaleString('en-GB')} multilingual concepts`;
		if (resultCount != null) {
			s += ` · ${resultCount.toLocaleString('en-GB')} match${resultCount === 1 ? '' : 'es'}`;
		}
		counts.replaceChildren(link, s);
	}

	function rerender() {
		if (!lastQuery) {
			const box = document.getElementById('wb-results');
			box.hidden = true; box.innerHTML = '';
			updateCounts(null);
			return;
		}
		const tokens = fold(lastQuery).split(/\s+/).filter(Boolean);
		const groups = groupForDirection(lastEntries, direction, lastSenses);
		const concepts = lastConcepts.filter((c) => conceptFits(c, direction));
		const articles = matchArticles(lastQuery);
		renderResults(groups, concepts, tokens, articles, lastQuery);
		updateCounts(groups.length + concepts.length);
	}

	async function runSearch() {
		const input = document.getElementById('wb-q');
		const box = document.getElementById('wb-results');
		const q = input.value.trim();
		lastQuery = q;
		if (!q) {
			box.hidden = true; box.innerHTML = '';
			updateCounts(null);
			return;
		}
		if (searchAbort) searchAbort.abort();
		searchAbort = new AbortController();
		try {
			// The direction goes to the API too: it ranks an exact hit on the
			// side carrying the SOURCE language first, so an English query
			// surfaces its Dutch equivalents instead of the rows that merely
			// share a Dutch prefix. It's a ranking hint, never a filter.
			const dirQuery = direction
				? '&from=' + encodeURIComponent(direction.src) + '&to=' + encodeURIComponent(direction.tgt)
				: '';
			const data = await getJSON(
				'/search?q=' + encodeURIComponent(q) + '&limit=' + FETCH_LIMIT + dirQuery + optsQuery(),
				searchAbort.signal
			);
			lastEntries = data.entries || [];
			lastSenses = data.senses || [];
			lastConcepts = data.concepts || [];
			// The API reports a failed concept lookup rather than passing it off
			// as "no concepts matched"; the word cards still show.
			if (data.concepts_error) console.warn('Concept search failed:', data.concepts_error);
			rerender();
		} catch (err) {
			if (err.name === 'AbortError') return;
			box.innerHTML = '<p class="wb-empty">Search is temporarily unavailable.</p>';
			box.hidden = false;
		}
	}

	function bindSearch() {
		const input = document.getElementById('wb-q');
		input.addEventListener('input', () => {
			clearTimeout(debounceTimer);
			debounceTimer = setTimeout(runSearch, DEBOUNCE_MS);
		});

		document.addEventListener('keydown', (ev) => {
			if (ev.key === '/' && document.activeElement !== input) {
				const tag = (document.activeElement?.tagName || '').toLowerCase();
				if (tag !== 'input' && tag !== 'textarea') {
					ev.preventDefault();
					input.focus();
					input.select();
				}
			}
			if (ev.key === 'Escape' && document.activeElement === input) {
				input.value = '';
				lastQuery = '';
				document.getElementById('wb-results').hidden = true;
				updateCounts(null);
			}
		});

		// Direction now steers the API's ranking as well as the client-side
		// grouping, so changing it re-runs the search rather than just
		// re-rendering the rows we happen to be holding.
		document.getElementById('wb-from').addEventListener('change', (ev) => {
			direction = { src: ev.target.value, tgt: direction.tgt };
			updateDirControls();   // re-derives valid To options for the new From
			runSearch();
		});
		document.getElementById('wb-to').addEventListener('change', (ev) => {
			direction.tgt = ev.target.value;
			updateDirControls();   // keeps the placeholder in step
			runSearch();
		});
		document.getElementById('wb-swap').addEventListener('click', () => {
			if (!direction) return;
			// Swap freely; updateDirControls() normalises if the reverse pair has
			// no data (and "Any" can sit on either side).
			direction = { src: direction.tgt, tgt: direction.src };
			updateDirControls();
			runSearch();
		});

		// Option toggles change the API result set → re-run the search.
		OPT_IDS.forEach((id) => {
			const el = document.getElementById(id);
			if (el) el.addEventListener('change', () => { saveOpts(); updateOptsToggle(); runSearch(); });
		});
	}

	async function main() {
		const counts = document.getElementById('wb-counts');
		if (!apiBase) {
			counts.textContent = 'Search API not configured (set PUBLIC_WORDBOOK_API).';
			return;
		}
		try {
			meta = await getJSON('/meta');
		} catch (err) {
			counts.textContent = 'Could not reach the Beijer Dictionary search API. ' + err.message;
			return;
		}
		const dirs = discoverDirections(meta.lang_pairs || []);
		if (!dirs.length) {
			counts.textContent = 'No language pairs available.';
			return;
		}
		// Sensible default: Dutch → English if present, else the first pair.
		direction = dirs.find((d) => d.src === 'nl' && d.tgt === 'en') || dirs[0];
		updateDirControls();
		loadOpts();        // restore the user's last search-option toggles
		bindSearch();
		updateCounts(null);

		// Deep-link support: ?q=…&from=nl&to=en runs a search on load. This is
		// how Beijer Dictionary embeds as a SuperLookup web resource (and makes search
		// URLs shareable). `from`/`to` are ISO 639-1 codes; if they match a known
		// direction it's selected, otherwise the default direction is kept.
		const params = new URLSearchParams(location.search);
		const from = (params.get('from') || '').toLowerCase();
		const to = (params.get('to') || '').toLowerCase();
		if (from && to) {
			const match = dirs.find((d) => d.src === from && d.tgt === to);
			if (match) {
				direction = match;
				updateDirControls();
			}
		}
		const q = params.get('q');
		if (q) {
			const input = document.getElementById('wb-q');
			input.value = q;
			runSearch();
		}
	}

	main();
</script>


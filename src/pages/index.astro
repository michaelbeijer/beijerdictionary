		font-size: 0.85rem;
		color: #555;
	}
	.wb-opts label {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		cursor: pointer;
		white-space: nowrap;
	}
	.wb-opts input { cursor: pointer; margin: 0; }
	.wb-opts-label { color: #777; }
	.wb-opts-sep {
		align-self: stretch;
		width: 1px;
		min-height: 1.1em;
		background: currentColor;
		opacity: 0.25;
	}
	@media (max-width: 520px) { .wb-opts-sep { display: none; } }
</style>

		font-size: 0.85rem;
		color: rgb(var(--muted));
	}
	.wb-opts label {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		cursor: pointer;
		white-space: nowrap;
	}
	.wb-opts input { cursor: pointer; margin: 0; }
	.wb-opts-label { color: rgba(var(--muted), 0.8); }
	.wb-opts-sep {
		align-self: stretch;
		width: 1px;
		min-height: 1.1em;
		background: currentColor;
		opacity: 0.25;
	}
	@media (max-width: 520px) { .wb-opts-sep { display: none; } }
	/* The options fold away on phones (see updateOptsToggle); wider screens
	   always show them and never see this button. */
	.wb-opts-toggle { display: none; }
	@media (max-width: 640px) {
		.wb-opts-toggle {
			display: inline-block;
			margin-top: 0.5rem;
			padding: 0.25rem 0;
			font: inherit;
			font-size: 0.85rem;
			color: rgb(var(--muted));
			background: none;
			border: none;
			cursor: pointer;
		}
		.wb-opts-toggle::after { content: ' ▾'; }
		.wb-opts-toggle[aria-expanded='true']::after { content: ' ▴'; }
		.wb-opts:not(.open) { display: none; }
		.wb-opts { margin-top: 0.2rem; }
	}
	.sense-num { display: inline-block; min-width: 1.35em; color: rgba(var(--muted), 0.75); font-weight: 600; font-variant-numeric: tabular-nums; }
	.wb-sense { margin-top: 5px; }
	/* Hand-curated, per-meaning definition shown under its sense line. */
	.wb-sensedef { margin: 1px 0 6px 1.7em; color: rgb(var(--muted)); font-size: 0.92em; line-height: 1.45; }
</style>

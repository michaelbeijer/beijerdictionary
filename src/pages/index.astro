---
import Base from '../layouts/Base.astro';
import ViewTabs from '../components/ViewTabs.astro';

// Search API base. Production sets PUBLIC_WORDBOOK_API to the deployed Worker
// URL; in `astro dev` it falls back to a local Worker on :8787. The terminology
// data is never shipped to the browser — only per-query result snippets.
const apiBase = (
	import.meta.env.PUBLIC_WORDBOOK_API ||
	(import.meta.env.DEV ? 'http://127.0.0.1:8787' : '')
).replace(/\/$/, '');
---

<Base
	title="Beijerterm — multilingual terminology for technical translators"
	description="A curated, searchable multilingual terminology database for technical translators — Dutch ↔ English and more, with full provenance."
>
	<section class="wb-hero">
		<h1>Beijerterm</h1>
		<p class="wb-tag">
			A curated, searchable multilingual terminology database for technical
			translators — with full provenance for every source.
		</p>
		<ViewTabs current="search" />
	</section>

	<section class="wb-view">
		<div class="wb-search">
			<label class="sr-only" for="wb-q">Search Beijerterm</label>
			<input id="wb-q" type="search" placeholder="Search…" autocomplete="off" spellcheck="false" autocapitalize="off" inputmode="search" />
			<div class="wb-controls">
				<label class="sr-only" for="wb-from">From language</label>
				<select id="wb-from" class="wb-lang" aria-label="From language"></select>
				<button id="wb-swap" type="button" class="wb-swap" aria-label="Swap languages">⇄</button>
				<label class="sr-only" for="wb-to">To language</label>
				<select id="wb-to" class="wb-lang" aria-label="To language"></select>
			</div>
			<div id="wb-opts" class="wb-opts">
				<span class="wb-opts-label">Search in:</span>
				<label><input type="checkbox" id="opt-in-terms" checked /> terms</label>
				<label><input type="checkbox" id="opt-in-def" /> definitions</label>
				<label><input type="checkbox" id="opt-in-notes" /> notes</label>
				<span class="wb-opts-sep" aria-hidden="true"></span>
				<label><input type="checkbox" id="opt-exact" /> Exact match</label>
				<label><input type="checkbox" id="opt-case" /> Case-sensitive</label>
				<label><input type="checkbox" id="opt-accent" /> Accent-sensitive</label>
				<label><input type="checkbox" id="opt-whole" /> Whole word</label>
				<span class="wb-opts-sep" aria-hidden="true"></span>
				<span class="wb-opts-label">Only entries with:</span>
				<label><input type="checkbox" id="opt-has-abbr" /> abbreviation</label>
				<label><input type="checkbox" id="opt-has-def" /> definition</label>
				<label><input type="checkbox" id="opt-has-notes" /> notes</label>
			</div>
			<div id="wb-counts" class="wb-counts">Loading…</div>
		</div>
		<div id="wb-results" class="wb-results" hidden></div>
		<p id="wb-hint" class="wb-hint">Type a term above to search the database.</p>
	</section>
</Base>

<script define:vars={{ apiBase }}>
	// ────────────────────────────────────────────────────────────────────
	// Beijerterm search — server-side via the Cloudflare Worker + D1 API.
	//
	// The browser NEVER receives the dataset. On load it fetches /meta (the
	// source inventory + language pairs), and on each keystroke it fetches
	// /search?q=… which returns only the matching entries. Results are grouped
	// client-side into one card per headword for the chosen direction.
	// ────────────────────────────────────────────────────────────────────

	const MAX_RESULTS = 50;
	const DEBOUNCE_MS = 180;

	// Admin mode (Michael only) — same gate as the footer Admin link in
	// Base.astro: visit ?admin once to enable it on this browser, ?admin=off to
	// disable. When on, each result shows an Edit pencil that deep-links to the
	// LOCAL admin app (only reachable on his machine). The public never sees it.
	const ADMIN_BASE = 'http://127.0.0.1:8765';
	let ADMIN = false;
	try {
		const ap = new URLSearchParams(location.search);
		if (ap.has('admin')) {
			if (ap.get('admin') === 'off') localStorage.removeItem('bt-admin');
			else localStorage.setItem('bt-admin', '1');
		}
		ADMIN = localStorage.getItem('bt-admin') === '1';
	} catch (e) { /* private mode / no storage — stay public */ }

	const LANG_LABELS = {
		nl: 'Dutch', en: 'English', de: 'German', fr: 'French',
		es: 'Spanish', it: 'Italian', pt: 'Portuguese', pl: 'Polish',
		ru: 'Russian', sv: 'Swedish', no: 'Norwegian', da: 'Danish',
		fi: 'Finnish', cs: 'Czech', ja: 'Japanese', zh: 'Chinese',
		la: 'Latin',
		any: 'Any',
	};
	const langName = (c) => LANG_LABELS[c] || (c || '').toUpperCase();

	const fold = (s) =>
		s == null ? '' : s.normalize('NFKD').replace(/\p{M}/gu, '').toLowerCase();

	const escapeHtml = (s) =>
		(s ?? '').replace(/[&<>"']/g, (c) => ({
			'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
		}[c]));

	// Position-preserving fold: the folded string plus a map from each folded
	// char index back to the original char index, so a match found in the folded
	// form can be highlighted in the original text (accents/ligatures included).
	function foldMap(s) {
		let folded = '';
		const map = [];
		for (let i = 0; i < s.length; i++) {
			const f = s[i].normalize('NFKD').replace(/\p{M}/gu, '').toLowerCase();
			for (let j = 0; j < f.length; j++) { folded += f[j]; map.push(i); }
		}
		return { folded, map };
	}
	const _isWord = (ch) => !!ch && /[\p{L}\p{N}]/u.test(ch);

	// Highlight whole words that start with any search token (accent/case-folded),
	// mirroring the FTS prefix-at-word-start match. Returns { html, hit }.
	function hl(text, tokens) {
		if (!text) return { html: '', hit: false };
		if (!tokens || !tokens.length) return { html: escapeHtml(text), hit: false };
		const { folded, map } = foldMap(text);
		const ranges = [];
		for (const tok of tokens) {
			if (!tok) continue;
			let from = 0, idx;
			while ((idx = folded.indexOf(tok, from)) !== -1) {
				from = idx + tok.length;
				if (idx > 0 && _isWord(folded[idx - 1])) continue;   // word-start only
				// Mark only the typed characters, not the rest of the word.
				const e = idx + tok.length;
				ranges.push([map[idx], e - 1 < map.length ? map[e - 1] + 1 : text.length]);
			}
		}
		if (!ranges.length) return { html: escapeHtml(text), hit: false };
		ranges.sort((a, b) => a[0] - b[0]);
		const merged = [ranges[0]];
		for (let k = 1; k < ranges.length; k++) {
			const last = merged[merged.length - 1];
			if (ranges[k][0] <= last[1]) last[1] = Math.max(last[1], ranges[k][1]);
			else merged.push(ranges[k]);
		}
		let out = '', pos = 0;
		for (const [s, e] of merged) {
			out += escapeHtml(text.slice(pos, s)) + '<mark>' + escapeHtml(text.slice(s, e)) + '</mark>';
			pos = e;
		}
		out += escapeHtml(text.slice(pos));
		return { html: out, hit: true };
	}

	// State
	let meta = { sources: [], lang_pairs: [], counts: { sources: 0, entries: 0 } };
	let direction = null;        // {src, tgt}
	let lastEntries = [];        // raw results from the last /search
	let lastQuery = '';
	let searchAbort = null;
	let debounceTimer = null;

	async function getJSON(path, signal) {
		const r = await fetch(apiBase + path, { signal, headers: { Accept: 'application/json' } });
		if (!r.ok) throw new Error('API returned ' + r.status);
		return r.json();
	}

	// Search-option checkboxes. The toggle group changes what the API returns,
	// so flipping any of them re-runs the search (not just a client re-render).
	const HAS_IDS = { abbr: 'opt-has-abbr', def: 'opt-has-def', notes: 'opt-has-notes' };
	const SCOPE_IDS = { terms: 'opt-in-terms', def: 'opt-in-def', notes: 'opt-in-notes' };
	const OPT_IDS = [...Object.values(SCOPE_IDS), 'opt-exact', 'opt-case', 'opt-accent',
		'opt-whole', ...Object.values(HAS_IDS)];
	const isOn = (id) => { const el = document.getElementById(id); return !!(el && el.checked); };

	// Build the &-prefixed query fragment from the current option state.
	function optsQuery() {
		const p = [];
		// "Search in" scope (defaults to terms only when nothing is ticked).
		const fields = Object.entries(SCOPE_IDS).filter(([, id]) => isOn(id)).map(([k]) => k);
		if (fields.length) p.push('fields=' + fields.join(','));
		if (isOn('opt-exact')) p.push('exact=1');
		if (isOn('opt-whole')) p.push('whole=1');
		if (isOn('opt-case')) p.push('case=1');
		if (isOn('opt-accent')) p.push('accent=1');
		const has = Object.entries(HAS_IDS).filter(([, id]) => isOn(id)).map(([k]) => k);
		if (has.length) p.push('has=' + has.join(','));
		return p.length ? '&' + p.join('&') : '';
	}

	function saveOpts() {
		try {
			const state = {};
			OPT_IDS.forEach((id) => { state[id] = isOn(id); });
			localStorage.setItem('bt-search-opts', JSON.stringify(state));
		} catch { /* ignore */ }
	}
	function loadOpts() {
		try {
			const state = JSON.parse(localStorage.getItem('bt-search-opts') || '{}');
			Object.entries(state).forEach(([id, v]) => {
				const el = document.getElementById(id);
				if (el) el.checked = !!v;
			});
		} catch { /* ignore */ }
	}

	function discoverDirections(pairs) {
		const dirs = [];
		for (const p of pairs) {
			dirs.push({ src: p.a, tgt: p.b });
			dirs.push({ src: p.b, tgt: p.a });
		}
		const seen = new Set();
		return dirs.filter((d) => {
			const k = d.src + '>' + d.tgt;
			if (seen.has(k)) return false;
			seen.add(k);
			return true;
		});
	}

	// Decide how an entry maps onto the chosen direction: which side is the
	// headword, which is the equivalent. Honours an "any" wildcard on either
	// side. Returns null if the entry doesn't belong in this direction.
	function orientForDirection(e, dir) {
		const src = dir.src, tgt = dir.tgt;
		const anyS = src === 'any', anyT = tgt === 'any';
		const mono = !e.b || !e.lb;
		if (mono) {
			// Monolingual entry (term + definition, no second-language equivalent):
			// show it whenever its single language is on either side (or Any).
			if (anyS || anyT || e.la === src || e.la === tgt) {
				return { head: e.a, qHead: e.qa, equiv: null, qEquiv: null, mono: true };
			}
			return null;
		}
		if (anyS && anyT) return { head: e.a, qHead: e.qa, equiv: e.b, qEquiv: e.qb, mono: false };
		if (!anyS && !anyT) {
			if (e.la === src && e.lb === tgt) return { head: e.a, qHead: e.qa, equiv: e.b, qEquiv: e.qb, mono: false };
			if (e.la === tgt && e.lb === src) return { head: e.b, qHead: e.qb, equiv: e.a, qEquiv: e.qa, mono: false };
			return null;
		}
		// Exactly one side is "any"; L is the concrete language.
		const L = anyS ? tgt : src;
		if (anyT) {
			// src = L, tgt = Any → the L side is the headword.
			if (e.la === L) return { head: e.a, qHead: e.qa, equiv: e.b, qEquiv: e.qb, mono: false };
			if (e.lb === L) return { head: e.b, qHead: e.qb, equiv: e.a, qEquiv: e.qa, mono: false };
		} else {
			// src = Any, tgt = L → the L side is the equivalent, the other the headword.
			if (e.lb === L) return { head: e.a, qHead: e.qa, equiv: e.b, qEquiv: e.qb, mono: false };
			if (e.la === L) return { head: e.b, qHead: e.qb, equiv: e.a, qEquiv: e.qa, mono: false };
		}
		return null;
	}

	// Group a flat entry list into ordered headword cards for a direction.
	// Insertion order preserves the server's bm25 ranking.
	function groupForDirection(entries, dir) {
		const index = new Map();
		const order = [];
		for (const e of entries) {
			const o = orientForDirection(e, dir);
			if (!o) continue;
			const { head, qHead, equiv, qEquiv, mono } = o;
			if (!head || (!mono && !equiv)) continue;
			const hf = fold(head);
			let g = index.get(hf);
			if (!g) {
				g = {
					display: head, headFold: hf,
					// Equivalents are bucketed by SENSE (the headword-side
					// qualifier, e.g. "toerekening (van baten in de tijd)"), so a
					// polysemous headword keeps its glosses instead of flattening
					// every translation into one undifferentiated list. Map key is
					// the gloss text ('' = no gloss); insertion order ≈ bm25 rank.
					senses: new Map(),
					sources: new Set(), domains: new Set(), defs: new Set(),
					notes: new Set(), abbrs: new Set(), idBySource: new Map(),
				};
				index.set(hf, g);
				order.push(g);
			}
			if (equiv) {
				const sk = qHead || '';
				let s = g.senses.get(sk);
				if (!s) { s = { qual: qHead || '', equivs: new Map() }; g.senses.set(sk, s); }
				const ef = fold(equiv);
				if (!s.equivs.has(ef)) s.equivs.set(ef, { display: equiv, qEquiv: qEquiv || '' });
			}
			if (e.src) String(e.src).split(',').forEach((s) => {
				const slug = s.trim();
				g.sources.add(slug);
				// Remember which master entry contributed this source, so the
				// admin Edit pencil can deep-link straight to that exact entry.
				if (e.id != null) g.idBySource.set(slug, e.id);
			});
			if (e.dom) g.domains.add(e.dom);
			if (e.def) g.defs.add(e.def);
			if (e.notes) g.notes.add(e.notes);
			if (e.abbr) g.abbrs.add(e.abbr);
		}
		return order;
	}

	function renderCard(group, tokens) {
		// Render one sense's equivalents (sorted) as a "· "-joined run of chips,
		// each optionally carrying its own equivalent-side qualifier.
		const renderEquivs = (equivs) =>
			[...equivs.values()].sort((a, b) => a.display.localeCompare(b.display)).map(({ display, qEquiv }) => {
				const h = hl(display, tokens);
				const qSpan = qEquiv ? ` <span class="qual">(${escapeHtml(qEquiv)})</span>` : '';
				return `<span class="e${h.hit ? ' hit' : ''}">${h.html}${qSpan}</span>`;
			}).join('');

		// Senses that actually have translations. One sense → inline (gloss sits
		// on the headword, as before). Multiple → one arrow-line per gloss, so the
		// reader can tell which translations belong to which sense.
		const equivSenses = [...group.senses.values()].filter((s) => s.equivs.size);
		const multiSense = equivSenses.length > 1;

		let equivBlock = '';
		if (equivSenses.length === 1) {
			equivBlock = `<div class="wb-equivs"><span class="arrow">→</span>${renderEquivs(equivSenses[0].equivs)}</div>`;
		} else if (multiSense) {
			equivBlock = equivSenses.map((s) => {
				const gloss = s.qual ? `<span class="sense-gloss">(${escapeHtml(s.qual)})</span> ` : '';
				return `<div class="wb-equivs wb-sense">${gloss}<span class="arrow">→</span>${renderEquivs(s.equivs)}</div>`;
			}).join('');
		}

		const defs = [...group.defs];
		const defHtml = defs.length
			? '<div class="wb-def">' + defs.slice(0, 2).map((d) => {
					const h = hl(d, tokens);
					return '<span class="d' + (h.hit ? ' hit' : '') + '">' + h.html + '</span>';
			  }).join('') + (defs.length > 2 ? ' <span class="d-more">+' + (defs.length - 2) + ' more</span>' : '') + '</div>'
			: '';

		const notes = [...group.notes];
		const notesHtml = notes.length
			? '<div class="wb-notes">' + notes.slice(0, 2).map((n) => {
					const h = hl(n, tokens);
					return '<span class="n' + (h.hit ? ' hit' : '') + '">' + h.html + '</span>';
			  }).join('') + (notes.length > 2 ? ' <span class="n-more">+' + (notes.length - 2) + ' more</span>' : '') + '</div>'
			: '';

		// Source chips link to that source on the Sources page (/sources#slug),
		// which opens its metadata. Plain links, so they work without JS too.
		// In admin mode, each chip gets an Edit pencil that opens the local admin
		// at the exact entry that contributed it.
		const meta_ = [
			...[...group.domains].slice(0, 1).map(escapeHtml),
			...[...group.sources].map((s) => {
				const chip = `<a class="pill pill-src" href="/sources#${encodeURIComponent(s)}" title="View this source on the Sources page">${escapeHtml(s)}</a>`;
				if (!ADMIN) return chip;
				const id = group.idBySource.get(s);
				const pencil = id != null
					? ` <a class="wb-edit" href="${ADMIN_BASE}/?edit=${id}" target="_blank" rel="noopener" title="Edit entry #${id} in the local admin">✎</a>`
					: '';
				return chip + pencil;
			}),
		].join(' · ');

		// The headword carries its gloss inline only when there is a single sense
		// (with multiple senses each gloss sits on its own arrow-line instead).
		// Fall back to the first sense's gloss for monolingual / no-equivalent cards.
		const allSenses = [...group.senses.values()];
		const headSense = equivSenses.length === 1 ? equivSenses[0]
			: (equivSenses.length === 0 && allSenses.length === 1 ? allSenses[0] : null);
		const qH = headSense && headSense.qual ? ` <span class="qual">(${escapeHtml(headSense.qual)})</span>` : '';
		// Show the abbreviation chip, unless it's identical to the headword
		// (a standalone acronym entry, e.g. "FOG", carries itself as its abbr).
		const abbrHtml = [...group.abbrs]
			.filter((x) => fold(x) !== group.headFold)
			.map((x) => ` <span class="wb-abbr" title="Abbreviation">${escapeHtml(x)}</span>`).join('');
		return `<article class="wb-card">
			<div class="wb-headword">${hl(group.display, tokens).html}${qH}${abbrHtml}</div>
			${equivBlock}
			${defHtml}
			${notesHtml}
			${meta_ ? `<div class="wb-card-meta">${meta_}</div>` : ''}
		</article>`;
	}

	function renderResults(groups, tokens) {
		const box = document.getElementById('wb-results');
		if (!groups.length) {
			box.innerHTML = '<p class="wb-empty">No matches.</p>';
			box.hidden = false;
			return;
		}
		const shown = groups.slice(0, MAX_RESULTS);
		box.innerHTML = shown.map((g) => renderCard(g, tokens)).join('')
			+ (groups.length > MAX_RESULTS
				? `<div class="wb-more">Showing ${MAX_RESULTS} of ${groups.length} headwords.</div>`
				: '');
		box.hidden = false;
	}

	// Adjacency map: source-lang → sorted list of target-langs it pairs with.
	// Built from the discovered directions so the To dropdown only ever offers
	// languages that actually have data with the chosen From language.
	function langAdjacency() {
		const adj = new Map();
		for (const d of discoverDirections(meta.lang_pairs || [])) {
			if (!adj.has(d.src)) adj.set(d.src, new Set());
			adj.get(d.src).add(d.tgt);
		}
		return adj;
	}

	const byName = (a, b) => langName(a).localeCompare(langName(b));

	// Every language that appears in any pair (for the "Any" From dropdown).
	function allLangs() {
		const s = new Set();
		for (const p of meta.lang_pairs || []) { s.add(p.a); s.add(p.b); }
		return [...s];
	}

	// Populate the From/To dropdowns to reflect `direction`. Both dropdowns lead
	// with an "Any" option (no language filter on that side). A concrete From
	// restricts To to languages it actually pairs with; an "Any" From offers all.
	function updateDirControls() {
		const fromSel = document.getElementById('wb-from');
		const toSel = document.getElementById('wb-to');
		const adj = langAdjacency();
		const langs = allLangs().sort(byName);
		if (!langs.length) return;
		const opt = (c) => `<option value="${c}">${escapeHtml(langName(c))}</option>`;

		if (!direction) direction = { src: 'nl', tgt: 'en' };

		const froms = ['any', ...langs];
		if (!froms.includes(direction.src)) direction.src = froms[0];
		fromSel.innerHTML = froms.map(opt).join('');
		fromSel.value = direction.src;

		const tos = direction.src === 'any'
			? ['any', ...langs]
			: ['any', ...[...(adj.get(direction.src) || [])].sort(byName)];
		if (!tos.includes(direction.tgt)) {
			direction.tgt = (tos.includes('en') && direction.src !== 'en') ? 'en' : tos[0];
		}
		toSel.innerHTML = tos.map(opt).join('');
		toSel.value = direction.tgt;

		const input = document.getElementById('wb-q');
		if (input && direction) {
			input.placeholder = `Search ${langName(direction.src)} → ${langName(direction.tgt)} (press /)`;
		}
	}

	function updateCounts(resultCount) {
		const counts = document.getElementById('wb-counts');
		const sN = meta.counts.sources || 0;
		const eN = meta.counts.entries || 0;
		let s = `${sN.toLocaleString('en-GB')} source${sN === 1 ? '' : 's'} · ` +
			`${eN.toLocaleString('en-GB')} entries`;
		if (resultCount == null) {
			s += ' — type to search';
		} else {
			s += ` · ${resultCount.toLocaleString('en-GB')} match${resultCount === 1 ? '' : 'es'}`;
		}
		counts.textContent = s;
	}

	function rerender() {
		if (!lastQuery) {
			const box = document.getElementById('wb-results');
			box.hidden = true; box.innerHTML = '';
			updateCounts(null);
			return;
		}
		const groups = groupForDirection(lastEntries, direction);
		renderResults(groups, fold(lastQuery).split(/\s+/).filter(Boolean));
		updateCounts(groups.length);
	}

	async function runSearch() {
		const input = document.getElementById('wb-q');
		const box = document.getElementById('wb-results');
		const q = input.value.trim();
		lastQuery = q;
		if (!q) {
			box.hidden = true; box.innerHTML = '';
			updateCounts(null);
			return;
		}
		if (searchAbort) searchAbort.abort();
		searchAbort = new AbortController();
		try {
			const data = await getJSON(
				'/search?q=' + encodeURIComponent(q) + '&limit=' + MAX_RESULTS + optsQuery(),
				searchAbort.signal
			);
			lastEntries = data.entries || [];
			rerender();
		} catch (err) {
			if (err.name === 'AbortError') return;
			box.innerHTML = '<p class="wb-empty">Search is temporarily unavailable.</p>';
			box.hidden = false;
		}
	}

	function bindSearch() {
		const input = document.getElementById('wb-q');
		input.addEventListener('input', () => {
			clearTimeout(debounceTimer);
			debounceTimer = setTimeout(runSearch, DEBOUNCE_MS);
		});

		document.addEventListener('keydown', (ev) => {
			if (ev.key === '/' && document.activeElement !== input) {
				const tag = (document.activeElement?.tagName || '').toLowerCase();
				if (tag !== 'input' && tag !== 'textarea') {
					ev.preventDefault();
					input.focus();
					input.select();
				}
			}
			if (ev.key === 'Escape' && document.activeElement === input) {
				input.value = '';
				lastQuery = '';
				document.getElementById('wb-results').hidden = true;
				updateCounts(null);
			}
		});

		document.getElementById('wb-from').addEventListener('change', (ev) => {
			direction = { src: ev.target.value, tgt: direction.tgt };
			updateDirControls();   // re-derives valid To options for the new From
			rerender();
		});
		document.getElementById('wb-to').addEventListener('change', (ev) => {
			direction.tgt = ev.target.value;
			rerender();
		});
		document.getElementById('wb-swap').addEventListener('click', () => {
			if (!direction) return;
			// Swap freely; updateDirControls() normalises if the reverse pair has
			// no data (and "Any" can sit on either side).
			direction = { src: direction.tgt, tgt: direction.src };
			updateDirControls();
			rerender();
		});

		// Option toggles change the API result set → re-run the search.
		OPT_IDS.forEach((id) => {
			const el = document.getElementById(id);
			if (el) el.addEventListener('change', () => { saveOpts(); runSearch(); });
		});
	}

	async function main() {
		const counts = document.getElementById('wb-counts');
		if (!apiBase) {
			counts.textContent = 'Search API not configured (set PUBLIC_WORDBOOK_API).';
			return;
		}
		try {
			meta = await getJSON('/meta');
		} catch (err) {
			counts.textContent = 'Could not reach the Beijerterm search API. ' + err.message;
			return;
		}
		const dirs = discoverDirections(meta.lang_pairs || []);
		if (!dirs.length) {
			counts.textContent = 'No language pairs available.';
			return;
		}
		// Sensible default: Dutch → English if present, else the first pair.
		direction = dirs.find((d) => d.src === 'nl' && d.tgt === 'en') || dirs[0];
		updateDirControls();
		loadOpts();        // restore the user's last search-option toggles
		bindSearch();
		updateCounts(null);

		// Deep-link support: ?q=…&from=nl&to=en runs a search on load. This is
		// how Beijerterm embeds as a SuperLookup web resource (and makes search
		// URLs shareable). `from`/`to` are ISO 639-1 codes; if they match a known
		// direction it's selected, otherwise the default direction is kept.
		const params = new URLSearchParams(location.search);
		const from = (params.get('from') || '').toLowerCase();
		const to = (params.get('to') || '').toLowerCase();
		if (from && to) {
			const match = dirs.find((d) => d.src === from && d.tgt === to);
			if (match) {
				direction = match;
				updateDirControls();
			}
		}
		const q = params.get('q');
		if (q) {
			const input = document.getElementById('wb-q');
			input.value = q;
			runSearch();
		}
	}

	main();
</script>

